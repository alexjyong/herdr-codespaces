#!/usr/bin/env bash
# Register GitHub Codespaces as herdr SSH machines. Works as a herdr plugin or from a plain shell.
set -euo pipefail

H="${HERDR_BIN_PATH:-herdr}"
CFG_REF="~/.ssh/codespaces"                 # as written in ~/.ssh/config's Include line
CFG="$HOME/.ssh/codespaces"
KH_REF="~/.ssh/codespaces_known_hosts"      # as written in the ssh config
KH="$HOME/.ssh/codespaces_known_hosts"
SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

die() { echo "error: $*" >&2; exit 1; }

# --- pure helpers (sourced by test/smoke.sh) ---

# stdin -> stdout: ssh config minus the block for codespace $1
drop_block() {
  awk -v h="Host herdr-cs.$1" 'index($0,"Host ")==1{skip=($0==h)} !skip'
}

# stdin -> stdout: `gh codespace ssh --config` output with a stable alias, a real known_hosts,
# and the ProxyCommand routed through `$3 guard` so reconnects can't wake a stopped codespace
# ponytail: $3 is spliced unquoted into ProxyCommand; breaks if the plugin path has spaces
patch_config() {
  sed -e "s#^Host .*#Host herdr-cs.$1#" \
      -e "s#^\([[:space:]]*ProxyCommand \)#\1$3 guard $1 #" \
      -e "s#UserKnownHostsFile=/dev/null#UserKnownHostsFile $2#" \
      -e 's#StrictHostKeyChecking no#StrictHostKeyChecking accept-new#'
}

# prepend "Include $2" to ssh config $1 unless present (backup to $1.bak)
ensure_include() {
  local cfg=$1 inc="Include $2"
  touch "$cfg"
  grep -qxF "$inc" "$cfg" && return 0
  cp "$cfg" "$cfg.bak"
  { echo "$inc"; cat "$cfg.bak"; } > "$cfg"
  chmod 600 "$cfg"
}

# stdin: `herdr machine list --json`; prints "id<TAB>label" for codespace $1
# ponytail: line-based JSON parse (no jq); relies on herdr's pretty output with id, label, target in order
machine_for() {
  awk -F'"' -v t="herdr-cs.$1" '$2=="id"{id=$4} $2=="label"{l=$4} $2=="target" && $4==t{print id "\t" l; exit}'
}

# stdin: `herdr machine list --json`; prints "label<TAB>codespace" for every herdr-cs.* machine
registered() {
  awk -F'"' '$2=="label"{l=$4} $2=="target" && index($4,"herdr-cs.")==1{print l "\t" substr($4,10)}'
}

# --- impure ---

machines() { "$H" machine list --json < /dev/null; }

codespaces() {
  gh codespace list --json name,displayName,repository,state,gitStatus \
    --jq '.[] | [.name,.displayName,.repository,.state,.gitStatus.ref] | @tsv'
}

# stdin rows -> the chosen row; fzf (extra args passed through) if available, else bash select
choose() {
  local header=$1; shift
  if command -v fzf > /dev/null; then fzf --delimiter='\t' --header="$header" "$@"; return; fi
  local IFS=$'\n' r rows; rows=$(cat)
  echo "$header" >&2
  select r in $rows; do [[ -n $r ]] && { echo "$r"; return; }; done < /dev/tty
  return 1
}

# codespace rows -> chosen row, showing GitHub display names instead of the generated codespace names
choose_codespace() {
  local rows; rows=$(codespaces)
  [[ -n $rows ]] || die "no codespaces (gh codespace list)"
  choose "$1" --with-nth=2.. <<<"$rows"
}

pick() { choose_codespace "$1" | cut -f1; }

ask() { local a; read -rp "$1 [y/N] " a; [[ $a == [yY]* ]]; }

link_herdr() {
  ssh -n "$1" '[ -x ~/.local/bin/herdr ] && sudo ln -sf ~/.local/bin/herdr /usr/local/bin/herdr; true'
}

# herdr panes are non-login shells, so /etc/profile.d/codespaces.sh never runs: no GITHUB_TOKEN (git auth)
# and no cd into the repo; nor does ~/.profile, where installers put PATH (~/.local/bin, cargo, elan,
# nix): tools installed there are missing. (Re)write a managed block in the remote ~/.bashrc that does
# all three. (Not login shells instead: codespaces.sh would cd every new pane into the repo.)
remote_bashrc() {
  ssh "$1" 'sed -i "/^# >>> herdr-codespaces/,/^# <<< herdr-codespaces/d" ~/.bashrc; cat >> ~/.bashrc' <<'SNIPPET'
# >>> herdr-codespaces (managed by the herdr-codespaces plugin; rewritten on add/refresh)
if [ -n "$HERDR_ENV" ]; then
  # ~/.profile includes this file again: the guard stops it there
  if [ -z "$HERDR_CS_PROFILE" ] && [ -r "$HOME/.profile" ]; then
    export HERDR_CS_PROFILE=1
    . "$HOME/.profile"
  fi
  # Everything under /workspaces is world-writable: ls would draw every folder blue on green
  # (dircolors' ow/tw), unreadable in most themes. Draw them as plain folders.
  [ -n "$LS_COLORS" ] && export LS_COLORS="$LS_COLORS:ow=01;34:tw=01;34"
  if [ -z "$GITHUB_TOKEN" ] && [ -r /workspaces/.codespaces/shared/.env-secrets ]; then
    while IFS= read -r line; do export "${line%%=*}=$(printf %s "${line#*=}" | base64 -d)"; done < /workspaces/.codespaces/shared/.env-secrets
  fi
  if [ "$PWD" = "$HOME" ]; then
    d=$(sed -n 's/^WORKING_DIRECTORY="\(.*\)"$/\1/p' /etc/profile.d/codespaces.sh 2>/dev/null)
    [ -d "$d" ] && cd "$d"
    unset d
  fi
fi
# <<< herdr-codespaces
SNIPPET
}

cmd_add() {
  local name=${1:-} label=${2:-} id="" old_label=""
  [[ -n $name ]] || name=$(pick "add which codespace?") || exit 1
  local alias="herdr-cs.$name"
  IFS=$'\t' read -r id old_label < <(machines | machine_for "$name") || true
  label=${label:-${old_label:-$(gh codespace view -c "$name" --json displayName -q .displayName < /dev/null)}}
  label=${label:-${name%-*}}

  echo "==> ssh config ($CFG)"
  mkdir -p ~/.ssh; touch "$CFG"; chmod 600 "$CFG"
  local fresh; fresh=$(gh codespace ssh -c "$name" --config | patch_config "$name" "$KH_REF" "$SELF")
  grep -qx "Host $alias" <<<"$fresh" || die "gh generated no ssh config for $name"
  { drop_block "$name" < "$CFG"; echo "$fresh"; echo; } > "$CFG.tmp" && mv "$CFG.tmp" "$CFG"
  ensure_include ~/.ssh/config "$CFG_REF"

  echo "==> connecting to $alias (starts the codespace if needed)"
  touch "$KH"
  ssh-keygen -R "$alias" -f "$KH" > /dev/null 2>&1 || true
  HERDR_CS_WAKE=1 ssh -n "$alias" true
  link_herdr "$alias"
  remote_bashrc "$alias"

  if [[ -n $id ]]; then
    echo "==> already registered as herdr machine '$old_label'; reconnecting open herdr clients"
    reconnect_clients "$id" "$alias" || echo "warning: herdr can't reach '$old_label' yet; clients keep retrying"
  else
    echo "==> herdr machine add --label $label $alias"
    "$H" machine add --label "$label" "$alias"   # interactive: may offer to install herdr remotely
    link_herdr "$alias"
  fi

  # offer the Claude integration only if claude is set up remotely and the integration isn't current
  local ci; ci=$(ssh -n "$alias" '[ -d ~/.claude ] && herdr integration status 2>/dev/null | grep "^claude:"' || true)
  case $ci in
    "") ;;                                   # no ~/.claude: nothing to integrate with
    *": current"*) echo "==> Claude integration already current" ;;
    *) if [[ -t 0 ]] && ask "Claude integration is ${ci#claude: } in $name; install/update it?"; then
         ssh -n "$alias" 'herdr integration install claude'
       fi ;;
  esac
  echo "done: $label -> $alias"
}

cmd_list() {
  local m name display repo state ref
  m=$(machines)
  while IFS=$'\t' read -r name display repo state ref; do
    printf '%-25s %-40s %-30s %-10s %-30s %s\n' "$display" "$name" "$repo" "$state" "$ref" \
      "$(machine_for "$name" <<<"$m" | cut -f2)"
  done < <(codespaces)
}

cmd_remove() {
  local name=${1:-} id="" label=""
  [[ -n $name ]] || name=$(pick "remove which codespace from herdr?") || exit 1
  IFS=$'\t' read -r id label < <(machines | machine_for "$name") || true
  [[ -n $id ]] && { "$H" machine remove "$id" < /dev/null; echo "removed herdr machine '$label'"; }
  if [[ -f $CFG ]]; then drop_block "$name" < "$CFG" > "$CFG.tmp" && mv "$CFG.tmp" "$CFG"; fi
  ssh-keygen -R "herdr-cs.$name" -f "$KH" > /dev/null 2>&1 || true
  echo "removed ssh config for $name (codespace itself untouched)"
}

cmd_stop() {
  local name=${1:-}
  [[ -n $name ]] || name=$(pick "stop which codespace?") || exit 1
  gh codespace stop -c "$name"
}

state() { gh codespace view -c "$1" --json state -q .state < /dev/null 2>/dev/null || echo unknown; }

# Whether herdr can reach machine $1 (ssh target $2). herdr before `machine status` (0.9.1 has none:
# it prints its usage and fails, every time) is asked through ssh instead.
reachable() {
  if "$H" machine status --help < /dev/null > /dev/null 2>&1; then
    "$H" machine status "$1" < /dev/null > /dev/null 2>&1
  else
    ssh -n -o ConnectTimeout=10 -o BatchMode=yes "$2" true > /dev/null 2>&1
  fi
}

# Open herdr clients back off to 2 minutes between attempts while a codespace is stopped, and nothing
# makes them retry sooner once it's up. Warm herdr's shared ssh master with `machine status` (up to
# 2 minutes), then disable+enable the machine: clients replace it with a fresh endpoint that connects
# immediately through the warm master. Fails if the machine never became reachable.
reconnect_clients() {
  local id=$1 alias=$2 i ok=1
  for (( i = 0; i < 24; i++ )); do
    reachable "$id" "$alias" && { ok=0; break; }
    sleep 5
  done
  "$H" machine disable "$id" < /dev/null > /dev/null
  sleep 2   # clients poll the machine catalog once a second; they must see the disable
  "$H" machine enable "$id" < /dev/null > /dev/null
  return $ok
}

cmd_start() {
  local name=${1:-} id="" label="" i
  [[ -n $name ]] || name=$(pick "start which codespace?") || exit 1
  [[ $name =~ ^[A-Za-z0-9-]+$ ]] || die "invalid codespace name: $name"
  echo "==> starting $name (takes about a minute)"
  gh api -X POST "/user/codespaces/$name/start" > /dev/null
  for (( i = 0; i < 60; i++ )); do
    [[ $(state "$name") == Available ]] && break
    sleep 5
  done
  [[ $(state "$name") == Available ]] || die "$name did not become available; check gh codespace list"
  IFS=$'\t' read -r id label < <(machines | machine_for "$name") || true
  if [[ -z $id ]]; then echo "started $name"; return; fi
  echo "==> reconnecting herdr machine '$label'"
  if reconnect_clients "$id" "herdr-cs.$name"; then
    echo "started $name; open herdr clients reconnect to '$label' now"
  else
    echo "started $name; herdr can't reach '$label' yet, open clients keep retrying"
  fi
}

cmd_toggle() {
  local row name display repo s
  row=$(choose_codespace "start/stop which codespace?") || exit 1
  IFS=$'\t' read -r name display repo s _ <<<"$row"
  case $s in
    Available) echo "==> stopping $display ($name)"; cmd_stop "$name" ;;
    Shutdown) cmd_start "$name" ;;
    *) die "$display is $s; try again once it settles" ;;
  esac
}

# ProxyCommand wrapper: only connect to a running codespace, unless HERDR_CS_WAKE is set (add/refresh)
cmd_guard() {
  local name=$1; shift
  if [[ -z ${HERDR_CS_WAKE:-} ]]; then
    local s; s=$(state "$name")
    [[ $s == Available ]] || { echo "herdr-codespaces: $name is $s; not waking it (use start or refresh)" >&2; exit 1; }
  fi
  exec "$@"
}

WIN_IDLE_PS='$ProgressPreference = "SilentlyContinue"
Add-Type -TypeDefinition @"
using System;
using System.Runtime.InteropServices;
public static class HerdrCsIdle {
  [StructLayout(LayoutKind.Sequential)] struct LastInput { public uint Size; public uint Time; }
  [DllImport("user32.dll")] static extern bool GetLastInputInfo(ref LastInput info);
  public static uint Seconds() {
    var info = new LastInput { Size = 8 };
    GetLastInputInfo(ref info);
    return unchecked((uint)Environment.TickCount - info.Time) / 1000;
  }
}
"@
[HerdrCsIdle]::Seconds()'

idle_seconds() {
  case $(uname -s) in
    Darwin) ioreg -c IOHIDSystem | awk '/HIDIdleTime/ && !d {print int($NF/1e9); d=1}' ;;
    Linux)
      if grep -qi microsoft /proc/version 2>/dev/null && command -v powershell.exe > /dev/null; then
        powershell.exe -NoProfile -NonInteractive -EncodedCommand \
          "$(printf %s "$WIN_IDLE_PS" | iconv -f utf-8 -t utf-16le | base64 -w0)" < /dev/null 2>/dev/null | tr -d '\r'
      elif command -v xprintidle > /dev/null; then
        echo $(( $(xprintidle) / 1000 ))
      else
        die "no idle time source: install xprintidle (X11) or run under WSL"
      fi ;;
    *) die "idle detection is not supported on $(uname -s)" ;;
  esac
}

# stop registered codespaces once there has been no keyboard/mouse input for N minutes,
# skipping any codespace with a working agent
cmd_idle_stop() {
  local limit=$(( ${1:-60} * 60 )) idle label name
  idle=$(idle_seconds)
  [[ $idle =~ ^[0-9]+$ ]] || die "could not read idle time: '$idle'"
  (( idle >= limit )) || return 0
  while IFS=$'\t' read -r label name; do
    [[ $(state "$name") == Available ]] || continue
    "$H" --machine "$label" workspace list < /dev/null 2>/dev/null | grep -q '"agent_status":"working"' && continue
    echo "$(date '+%F %T') idle $((idle / 60))m: stopping $name"
    gh codespace stop -c "$name" < /dev/null
  done < <(machines | registered)
}

PLIST="$HOME/Library/LaunchAgents/dev.herdr.codespaces.autostop.plist"

cmd_autostop() {
  case $(uname -s) in
    Darwin) autostop_launchd "$@" ;;
    Linux) autostop_systemd "$@" ;;
    *) die "autostop is not supported on $(uname -s)" ;;
  esac
}

UNIT_DIR="$HOME/.config/systemd/user"
UNIT=herdr-codespaces-autostop

autostop_systemd() {
  if [[ -f $UNIT_DIR/$UNIT.timer ]]; then
    systemctl --user disable --now "$UNIT.timer" 2>/dev/null || true
  fi
  case ${1:-} in
    off)
      rm -f "$UNIT_DIR/$UNIT.service" "$UNIT_DIR/$UNIT.timer"
      systemctl --user daemon-reload
      echo "autostop off" ;;
    on)
      local mins=${2:-60} herdr path display=""
      [[ $mins =~ ^[0-9]+$ ]] || die "minutes must be a number"
      herdr=$(command -v "$H") || die "herdr not found"
      path="$(dirname "$(command -v gh)"):$(dirname "$herdr")"
      if command -v powershell.exe > /dev/null; then path+=":$(dirname "$(command -v powershell.exe)")"; fi
      path+=":/usr/local/bin:/usr/bin:/bin"
      [[ -n ${DISPLAY:-} ]] && display="Environment=\"DISPLAY=$DISPLAY\""
      idle_seconds > /dev/null
      mkdir -p "$UNIT_DIR"
      cat > "$UNIT_DIR/$UNIT.service" <<UNIT
[Unit]
Description=Stop GitHub Codespaces registered in herdr after ${mins}m without keyboard/mouse input

[Service]
Type=oneshot
Environment="PATH=$path"
Environment="HERDR_BIN_PATH=$herdr"
$display
ExecStart="$SELF" idle-stop $mins
UNIT
      cat > "$UNIT_DIR/$UNIT.timer" <<UNIT
[Unit]
Description=Check every 5 minutes for idle GitHub Codespaces registered in herdr

[Timer]
OnStartupSec=5min
OnUnitActiveSec=5min

[Install]
WantedBy=timers.target
UNIT
      systemctl --user daemon-reload
      systemctl --user enable --now "$UNIT.timer"
      echo "autostop on: stops idle codespaces after ${mins}m of no input (log: journalctl --user -u $UNIT)" ;;
    *) die "usage: autostop on [minutes] | off" ;;
  esac
}

# install/remove a launchd job that runs idle-stop every 5 minutes
autostop_launchd() {
  launchctl bootout "gui/$(id -u)" "$PLIST" 2>/dev/null || true
  case ${1:-} in
    off) rm -f "$PLIST"; echo "autostop off" ;;
    on)
      local mins=${2:-60} herdr path
      herdr=$(command -v "$H") || die "herdr not found"
      path="$(dirname "$(command -v gh)"):$(dirname "$herdr"):/usr/bin:/bin:/usr/sbin"
      mkdir -p "$(dirname "$PLIST")"
      cat > "$PLIST" <<PL
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>dev.herdr.codespaces.autostop</string>
  <key>ProgramArguments</key><array><string>$SELF</string><string>idle-stop</string><string>$mins</string></array>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>$path</string>
    <key>HERDR_BIN_PATH</key><string>$herdr</string>
  </dict>
  <key>StartInterval</key><integer>300</integer>
  <key>StandardOutPath</key><string>$HOME/Library/Logs/herdr-codespaces.log</string>
  <key>StandardErrorPath</key><string>$HOME/Library/Logs/herdr-codespaces.log</string>
</dict></plist>
PL
      launchctl bootstrap "gui/$(id -u)" "$PLIST"
      echo "autostop on: stops idle codespaces after ${mins}m of no input (log: ~/Library/Logs/herdr-codespaces.log)" ;;
    *) die "usage: autostop on [minutes] | off" ;;
  esac
}

cmd_menu() {
  local c
  c=$(printf '%s\n' toggle add refresh remove start stop list | choose "codespaces") || exit 0
  "cmd_${c/refresh/add}"
}

main() {
  case ${1:-} in
    add|refresh) shift; cmd_add "$@" ;;
    list) cmd_list ;;
    remove) shift; cmd_remove "$@" ;;
    stop) shift; cmd_stop "$@" ;;
    start) shift; cmd_start "$@" ;;
    toggle) cmd_toggle ;;
    guard) shift; cmd_guard "$@" ;;
    idle-stop) shift; cmd_idle_stop "$@" ;;
    autostop) shift; cmd_autostop "$@" ;;
    menu) trap 'echo; read -rsn1 -p "press any key to close" || true' EXIT; cmd_menu ;;
    *) echo "usage: herdr-codespaces add|refresh|remove|start|stop [name] [label] | toggle | list | menu | autostop on [min]|off"; exit 2 ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
